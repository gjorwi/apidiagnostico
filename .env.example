NODE_ENV=development
PORT=4000

# Base de datos.
# Desarrollo local (por defecto) usa un MongoDB en tu máquina:
MONGO_URI=mongodb://127.0.0.1:27017/diagnosticos
# Producción / Atlas: reemplaza la línea anterior por tu cadena SRV:
#   MONGO_URI=mongodb+srv://usuario:password@cluster.xxxxx.mongodb.net/diagnosticos?retryWrites=true&w=majority
# Opcional: fuerza el nombre de la base si no viene incluido en la URI.
# MONGO_DB_NAME=diagnosticos

# Para desarrollo sin MongoDB real (los datos se pierden al reiniciar):
USE_MEMORY_DB=false

JWT_SECRET=cambiar-por-secreto-largo-de-acceso
JWT_REFRESH_SECRET=cambiar-por-secreto-largo-de-refresh
WEB_ORIGINS=http://localhost:3000,http://localhost:3001
COOKIES_SEGURAS=false
SEED_DEMO=true
ADMIN_EMAIL=admin@diagnosticos.local
ADMIN_PASSWORD=Admin1234
